# Backend (Spring Boot) Deployment Environment Variables
# -----------------------------------------------------

# Port (Cloud providers like Render, Railway, AWS, Heroku provide this automatically)
PORT=8080

# Active Profile:
# Leave blank (or set to 'default') for Supabase (PostgreSQL)
# Or set 'h2' for local zero-setup in-memory database testing
SPRING_PROFILES_ACTIVE=

# -----------------------------------------------------
# Supabase (PostgreSQL) Database Configuration
# -----------------------------------------------------

# Option 1 (Recommended): Full JDBC Connection String from Supabase:
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC
#
# Direct connection (Session mode):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (Port 6543 - Recommended for cloud deployments / serverless):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Credentials:
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Option 2: Individual variables
# DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_db_password

# -----------------------------------------------------
# JWT Authentication (Optional: defaults to built-in secure key)
# -----------------------------------------------------
JWT_SECRET=vsms-secret-jwt-token-key-2026-very-secure-must-be-at-least-256-bits-long
JWT_EXPIRATION_DAYS=7
