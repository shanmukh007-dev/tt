# Backend (Spring Boot) Deployment Environment Variables
# -----------------------------------------------------

# Port (Cloud providers like Render, Railway, AWS, Heroku provide this automatically)
PORT=8080

# Active Profile:
# Use 'h2' for instant zero-setup deployment (in-memory DB + auto-loaded seed data)
# Use 'default' (or leave blank) to connect to a real MySQL database
SPRING_PROFILES_ACTIVE=h2

# Database Configuration (Only needed if NOT using h2)
# Option 1: Full JDBC Connection URL
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/autopulse_vsm?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Option 2: Individual MySQL variables (if your cloud provider provides these separately)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=autopulse_vsm
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# JWT Authentication (Optional: defaults to built-in secure key)
JWT_SECRET=vsms-secret-jwt-token-key-2026-very-secure-must-be-at-least-256-bits-long
JWT_EXPIRATION_DAYS=7
