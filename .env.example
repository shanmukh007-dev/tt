# AutoPulse VSM - Deployment Environment Variables
# =======================================================

# -------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Spring Boot + Supabase)
# -------------------------------------------------------

# Listening Port (Cloud hosts like Render, Railway, Heroku auto-assign $PORT)
PORT=8080

# Profile selection:
# - Leave blank (or 'default') to connect to Supabase
# - Set to 'h2' for local zero-configuration testing (in-memory DB + auto seed data)
SPRING_PROFILES_ACTIVE=

# -------------------------------------------------------
# Supabase PostgreSQL Connection:
# Find these in your Supabase Dashboard:
# Project Settings -> Database -> Connection string -> JDBC
# -------------------------------------------------------

# Direct Connection URL (Session mode):
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Or Transaction Pooler URL (Port 6543 - recommended for serverless / cloud apps):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# JWT Security (Optional - safe built-in default is provided)
JWT_SECRET=vsms-secret-jwt-token-key-2026-very-secure-must-be-at-least-256-bits-long
JWT_EXPIRATION_DAYS=7


# -------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (React / Vite)
# -------------------------------------------------------

# API Base URL:
# - Leave BLANK / UNSET if using the unified Docker container (Render) where Spring Boot serves both frontend + API on the same domain.
# - Set to your deployed backend URL ONLY if deploying the frontend on a separate service (e.g., Vercel, Netlify):
VITE_API_BASE_URL=https://your-backend-service.onrender.com
