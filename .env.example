# AutoPulse VSM - Deployment Environment Variables
# =======================================================

# -------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Spring Boot)
# -------------------------------------------------------

# Listening Port (Cloud hosts like Render, Railway, Heroku auto-assign $PORT)
PORT=8080

# Profile selection:
# - Set to 'h2' for instant zero-configuration cloud deployment (in-memory DB + auto seed data)
# - Set to 'default' (or leave blank) when connecting to a real MySQL instance
SPRING_PROFILES_ACTIVE=h2

# Database Connection (Required when using MySQL):
# Option A: Full Connection URL (from Render MySQL, Railway, Aiven, Supabase, or AWS RDS)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/autopulse_vsm?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Option B: Individual MySQL credentials (if not providing SPRING_DATASOURCE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=autopulse_vsm
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# JWT Security (Optional - safe default is provided)
JWT_SECRET=vsms-secret-jwt-token-key-2026-very-secure-must-be-at-least-256-bits-long
JWT_EXPIRATION_DAYS=7


# -------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (React / Vite)
# -------------------------------------------------------

# API Base URL:
# - Leave BLANK / UNSET if using the unified Docker container (Render) where Spring Boot serves both frontend + API on the same domain.
# - Set to your deployed backend URL ONLY if deploying the frontend on a separate service (e.g., Vercel, Netlify):
VITE_API_BASE_URL=https://your-backend-service.onrender.com
